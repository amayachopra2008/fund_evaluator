# ---- replacement ranking
def mk(sym, alpha, sharpe, dd, val, flags=0, sector="IT", ind="Software"):
    return dict(symbol=sym, name=sym, sector=sector, industry=ind, alpha=alpha, sharpe=sharpe,
                downside_capture=80, current_drawdown=dd, valuation=val, flags=["x"] * flags, error=None)
tgt = mk("T", -3, 0.2, -30, "Overvalued", 3)
cands = [mk("good", 5, 1.2, -5, "Undervalued"), mk("ok", 2, 0.8, -10, "Fairly priced"),
         mk("pricey", 6, 1.3, -4, "Overvalued"), mk("broken", 9, 2, -1, "Undervalued", flags=2),
         mk("othersector", 9, 2, -1, "Undervalued", sector="Fin"), {"symbol": "err", "error": "x"}]
rk = [r["symbol"] for r in eng.rank_replacements(tgt, cands)]
assert rk[0] == "good" and "broken" not in rk and "othersector" not in rk and "err" not in rk, rk

