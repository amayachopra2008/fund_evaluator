# ---- Word document with a table
import docx
d = docx.Document()
t = d.add_table(rows=3, cols=2)
for i, row in enumerate([("Stock", "Weight %"), ("Wipro", "4"), ("Cipla", "6")]):
    for j, v in enumerate(row):
        t.cell(i, j).text = v
buf = io.BytesIO(); d.save(buf); buf.seek(0); buf.name = "p.docx"
sh, ln = eng.load_sources(uploaded=buf)
h7, _ = eng.extract_holdings(sh, ln)
assert list(h7["input_name"]) == ["Wipro", "Cipla"] and list(h7["weight_pct"]) == [4, 6], h7

