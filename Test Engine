# ---- risk metrics on synthetic prices (bench rises, stock bleeds)
rng = np.random.default_rng(0)
idx = pd.bdate_range("2020-11-01", "2026-11-10")
bench = pd.Series(100 * np.cumprod(1 + rng.normal(0.0005, 0.008, len(idx))), index=idx)
bad = pd.Series(100 * np.cumprod(1 + rng.normal(-0.0006, 0.018, len(idx))), index=idx)
good = pd.Series(100 * np.cumprod(1 + 0.0004 + 1.1 * bench.pct_change().fillna(0) + rng.normal(0, 0.003, len(idx))),
                 index=idx)
mb, mg = eng.compute_risk_metrics(bad, bench), eng.compute_risk_metrics(good, bench)
assert mb["alpha"] < mg["alpha"] and mb["sharpe"] < mg["sharpe"], (mb, mg)
assert mb["current_drawdown"] < 0 and mb["neg_year_streak"] >= 1, mb
flags_b, status_b = eng.exit_assessment(mb)
flags_g, status_g = eng.exit_assessment(mg)
assert status_b in ("EXIT REVIEW", "EXIT RECOMMENDED"), (status_b, flags_b)
assert len(flags_g) < len(flags_b)
assert eng.compute_risk_metrics(bad.iloc[:100], bench) is None
assert eng.streak_counts([1, -1, -1, 1, -1, -1, -1]) == (3, 3) and eng.streak_counts([-1, 1]) == (1, 0)

